---
// Definimos las props que recibirá el componente
const { name, bio, twitter, avatar } = Astro.props;
---

<div class="author-card">
  <img src={avatar} alt={`Foto de ${name}`} class="author-avatar" />
  <div class="author-info">
    <h3>Escrito por: {name}</h3>
    <p>{bio}</p>
    <a href={`https://twitter.com/${twitter}`} target="_blank">Seguir a @{twitter}</a>
  </div>
</div>

<style>
  .author-card {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: #f4f7f9;
    border-radius: 12px;
    margin-top: 3rem;
    border: 1px solid #e1e8ed;
  }
  .author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
  }
  .author-info h3 { margin: 0; color: #00539F; }
  .author-info p { margin: 0.5rem 0; font-size: 0.95rem; }
  .author-info a { color: #1da1f2; text-decoration: none; font-weight: bold; }
</style>