---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const frontmatter = {
    title: "Astro",
    pubDate: "2026-03-14",
    description: "Informacion sobre Astro",
    tags:["astro", "bloguear", "aprender en público", "conocimiento"],
    image: {
        url: "https://images.prismic.io/juneikerc/066c72e8-4dcb-4df8-aeab-a753469db667_astro-build.png",
        alt: "Logo"
    },
    author: 'Sarasuadi',
    authorBio: 'Desarrollador en formación y entusiasta de Astro.',
    authorAvatar: 'https://avatars.githubusercontent.com/u/1234567'
}
import AuthorCard from '../../components/AuthorCard.astro';
---


<BaseLayout pageTitle={frontmatter.title}>
   

<p>{frontmatter.pubDate.toString().slice(0,10)}</p>
  <p><em>{frontmatter.description}</em></p>
<img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />
 
  <div class="tags">
    {frontmatter.tags.map((tag) => (
      <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
    ))}
  </div>
  <h2>Astro</h2>
  <p>
   Astro es un framework de aplicaciones web basado en JavaScript de código abierto. Fue creado por Fred K. Schott y
    varios colaboradores, quienes a día de hoy lo siguen manteniendo 
   junto con la ayuda de cientos de usuarios que mejoran el código gracias a su naturaleza de código libre.
  </p>

  <AuthorCard 
    name={frontmatter.author} 
    bio={frontmatter.authorBio} 
    avatar={frontmatter.authorAvatar}
    twitter="astro_dev" 
  />

</BaseLayout>



<style>
  a {
    color: #00539F;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>